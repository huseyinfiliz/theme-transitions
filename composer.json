{
    "name": "huseyinfiliz/theme-transitions",
    "description": "Smooth, customizable View Transition animations for Flarum 2 theme switching.",
    "keywords": [
        "extension",
        "flarum",
        "dark mode",
        "theme",
        "transitions",
        "animations",
        "view transitions"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/huseyinfiliz/theme-transitions/issues",
        "source": "https://github.com/huseyinfiliz/theme-transitions"
    },
    "homepage": "https://huseyinfiliz.com/flarum/",
    "require": {
        "flarum/core": "^2.0"
    },
    "authors": [
        {
            "name": "Hüseyin Filiz",
            "email": "mysuperuser01@gmail.com",
            "role": "Developer"
        }
    ],
    "autoload": {
        "psr-4": {
            "HuseyinFiliz\\ThemeTransitions\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Theme Transitions",
            "category": "feature",
            "icon": {
                "name": "fas fa-wand-magic-sparkles",
                "color": "#fff",
                "backgroundColor": "#3498db"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": true,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "frontendTesting": true,
                "backendTesting": true,
                "phpstan": false,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "HuseyinFiliz\\ThemeTransitions\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:unit:filter": "phpunit -c tests/phpunit.unit.xml --filter",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:integration:filter": "phpunit -c tests/phpunit.integration.xml --filter",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:unit:filter": "Runs unit tests whose name matches: composer test:unit:filter -- ClassName",
        "test:integration": "Runs all integration tests.",
        "test:integration:filter": "Runs integration tests whose name matches: composer test:integration:filter -- ClassName",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "require-dev": {
        "flarum/testing": "^2.0"
    }
}
